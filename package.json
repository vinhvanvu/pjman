{
  "name": "pjman",
  "version": "0.1.0",
  "description": "A context graph for product development: typed records in git under one schema, and the tool that is the schema.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pjman": "./bin/pjman.js"
  },
  "files": [
    "bin",
    "dist",
    "adapters",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "npm run build && npm --prefix ui run build",
    "install:local": "node scripts/install-local.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
