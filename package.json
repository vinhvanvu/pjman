{
  "name": "@vinhvanvu/pjman",
  "version": "0.4.0",
  "description": "A context graph for product development: typed records in git under one schema, and the tool that is the schema.",
  "keywords": [
    "context-graph",
    "product-development",
    "decisions",
    "changes",
    "agents",
    "claude-code",
    "mcp",
    "markdown",
    "git"
  ],
  "homepage": "https://github.com/vinhvanvu/pjman#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhvanvu/pjman.git"
  },
  "bugs": {
    "url": "https://github.com/vinhvanvu/pjman/issues"
  },
  "author": "Vinh Van Vu",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pjman": "./bin/pjman.js"
  },
  "files": [
    "bin",
    "dist/store",
    "dist/hosts",
    "dist/model",
    "dist/ops",
    "dist/sync",
    "dist/server",
    "dist/cli",
    "dist/ui",
    "adapters",
    ".claude-plugin",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "npm run build && npm --prefix ui run build",
    "install:local": "node scripts/install-local.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "dev": "node scripts/dev.mjs",
    "release": "node scripts/release.mjs",
    "docs": "npm run build && node scripts/docs.mjs",
    "bench": "npm run build && node scripts/bench.mjs"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "portless": "^0.15.12",
    "typescript": "^5.6.3"
  }
}
